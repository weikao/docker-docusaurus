# ============================================================
# 环境变量样例（复制为 .env 后按需修改）
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# ============================================================

# Docusaurus 版本（对应基础镜像 tag）
# 升级时只需修改为目标版本，然后执行：
#   docker compose pull && docker compose up -d
DOCUSAURUS_VERSION=3.10.2

# 本地镜像名称（docker compose 构建/运行时使用）
IMAGE_NAME=docusaurus-site

# 基础镜像源（国内加速），可选：docker.1ms.run、docker.xuanyuan.me
# 海外环境可改为 docker.io
BASE_REGISTRY=docker.m.daocloud.io

# （可选）Docker Hub 仓库名，供 build-hub.bat 推送到 hub.docker.com
# 格式必须为 <用户名>/<镜像名>，不设置则用 IMAGE_NAME
# DOCKERHUB_REPO=myname/docusaurus-site

# ============================================================
# 多语言（i18n）配置 —— 单域名子路径方案
# ------------------------------------------------------------
# 默认语言（放站点根路径 /），沿用 SITE_LOCALE；留空则 zh-Hans
# SITE_LOCALE=zh-Hans
#
# 附加语言：逗号分隔的 locale 代码，站点将编译到 /<locale>/ 子路径
# 例：SITE_LOCALES_EXTRA=en,ja  → 产出 /（默认语言）、/en/、/ja/
# 留空 = 单语言模式（保持现状，行为完全不变）
#
# 支持的 locale 代码参见 Docusaurus 官方 i18n 文档；开启前请先执行：
#   cd site && npm run write-translations -- --locale en
# 并把 docs/ 复制一份到 site/i18n/en/docusaurus-plugin-content-docs/current/
# ============================================================
# SITE_LOCALES_EXTRA=en
